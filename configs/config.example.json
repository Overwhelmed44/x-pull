{
  "poll_interval": "30s",
  "workers": 4,
  "xray": {
    "address": "127.0.0.1:10085",
    "timeout": "5s"
  },
  "http": {
    "timeout": "10s",
    "max_response_bytes": 4194304
  },
  "inbounds": [
    {
      "tag": "vless-in",
      "protocol": "vless",
      "email_prefix": "pull:",
      "allow_empty": false,
      "source": {
        "url": "http://127.0.0.1:8080/users.example.json",
        "headers": {},
        "headers_env": {}
      }
    }
  ]
}
